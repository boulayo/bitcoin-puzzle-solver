{
  "problemMatcher": [
    {
      "owner": "cc",
      "pattern": [
        {
          "regexp": "^(.+?):(\\d+):(\\d+): (warning|error|fatal error): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      ]
    }
  ]
}
